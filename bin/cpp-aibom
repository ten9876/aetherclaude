#!/usr/bin/env python3
"""cpp-aibom — C++ AI Bill of Materials scanner.

Scans a C++ codebase against a knowledge base of known AI/ML, DSP, audio, codec,
network, and dependency libraries. Produces an inventory plus per-component CVE
lookups against OSV.dev. Outputs in three formats:

  - aibom-json   (default; the shape the AetherClaude dashboard ingests)
  - cyclonedx    (CycloneDX 1.6 ML-BOM — for release artifacts / compliance)
  - sarif        (SARIF 2.1.0 — CVE findings rendered as PR annotations)

USAGE
    cpp-aibom scan PATH [--format FMT] [--output FILE] [--config FILE] [--no-osv]
    cpp-aibom diff BASELINE CURRENT

If invoked without a subcommand and given a path, defaults to `scan`.

CONFIG OVERRIDES (.aibom.json in target root or via --config)
    {
      "excludes": ["KissFFT"],
      "overrides": {
        "RNNoise": {"confidence": "high", "license": "BSD-3-Clause"}
      },
      "custom_components": [
        {"name": "AetherDSP-internal", "category": "dsp", "description": "..."}
      ]
    }

INVENTORY SOURCES (merged, one record per component)
    - THIRD_PARTY_LICENSES sections: name, version, pinned commit, license,
      source, delivery (bundled / prebuilt / download-on-demand), Go module
      tables and libraries bundled inside a prebuilt binary
    - third_party/<dir>: VERSION.txt, COMMIT, README.aethersdr.md, version
      defines in headers, license files
    - FetchContent_Declare pins in the project's own CMake files
    - KB detections (includes + CMake) for system and package-manager libraries

DESIGN NOTES
    KB lives in data/cpp-aibom-components.json — adding components is a data PR.
    OSV.dev lookups: versioned purls for ecosystems OSV indexes (Go, PyPI, …);
    C/C++ sources by repository plus pinned commit or release tag (GIT).
    OSV.dev responses cached at ~/.cache/cpp-aibom/osv/ for 7 days.
    Confidence is high if both an include AND a cmake signal fire, medium if one
    fires, low only via .aibom.json override.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import hashlib
import json
import os
import pwd
import re
import sys
import time
import uuid
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

VERSION = "2.1.0"


def _real_home() -> Path:
    """The current user's actual home dir from passwd.

    Path.home() / os.path.expanduser('~') trust $HOME, which is wrong when
    invoked via `sudo -u <user>` without `env HOME=...` — $HOME stays as the
    caller's path and breaks the OSV cache mkdir. passwd is authoritative.
    """
    try:
        return Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, OSError):
        return Path.home()


# ── Paths / config ─────────────────────────────────────────────────────────────
REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_KB = REPO_ROOT / "data" / "cpp-aibom-components.json"
DEFAULT_OUT = Path("/Users/aetherclaude/logs/aibom-latest.json")
OSV_CACHE_DIR = Path(
    os.environ.get("CPP_AIBOM_CACHE") or str(_real_home() / ".cache" / "cpp-aibom" / "osv")
)
OSV_CACHE_TTL = 7 * 24 * 3600  # seconds
OSV_API_URL = "https://api.osv.dev/v1/query"
OSV_TIMEOUT = 15
OSV_MAX_RETRIES = 2

SOURCE_EXTS = {".cpp", ".cc", ".cxx", ".c", ".h", ".hpp", ".hh", ".hxx"}
CMAKE_BASENAMES = {"CMakeLists.txt"}
CMAKE_EXTS = {".cmake"}
IGNORE_DIRS = {
    ".git", "build", "build-debug", "build-release", "out", "cmake-build-debug",
    "cmake-build-release", ".vs", ".idea", "vcpkg_installed", "_deps", ".venv",
    "node_modules", "__pycache__",
}

# ── Regex ──────────────────────────────────────────────────────────────────────
_RE_INCLUDE = re.compile(r'^\s*#\s*include\s*[<"]([^>"]+)[>"]', re.MULTILINE)
_RE_FIND_PACKAGE = re.compile(r'find_package\s*\(\s*([A-Za-z0-9_+.-]+)', re.IGNORECASE)
_RE_PKG_CHECK = re.compile(r'pkg_check_modules\s*\([^)]*?([A-Za-z0-9_+.-]+)\s*(?:>=|=|<=)?', re.IGNORECASE)
_RE_TLL = re.compile(r'target_link_libraries\s*\(([^)]*)\)', re.IGNORECASE | re.DOTALL)
_RE_INCLUDE_CALL = re.compile(r'^\s*include\s*\(\s*([A-Za-z0-9_+.-]+)', re.IGNORECASE | re.MULTILINE)


# ── Helpers ────────────────────────────────────────────────────────────────────
def _iso_now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _purl_hash(purl: str) -> str:
    return hashlib.sha256(purl.encode()).hexdigest()[:16]


def _atomic_write(path: Path, data: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(data)
    tmp.replace(path)


# ── KB loader ──────────────────────────────────────────────────────────────────
def load_kb(kb_path: Path) -> list[dict[str, Any]]:
    if not kb_path.exists():
        sys.exit(f"cpp-aibom: KB not found at {kb_path}")
    data = json.loads(kb_path.read_text())
    components = data.get("components", [])
    seen = set()
    for c in components:
        n = c.get("name")
        if not n:
            sys.exit(f"cpp-aibom: KB entry missing 'name': {c}")
        if n in seen:
            sys.exit(f"cpp-aibom: duplicate KB entry '{n}'")
        seen.add(n)
        c.setdefault("detect", {})
        c["detect"].setdefault("include", [])
        c["detect"].setdefault("cmake", [])
    return components


# ── Override config (.aibom.json) ──────────────────────────────────────────────
def load_overrides(target: Path, explicit: Path | None) -> dict[str, Any]:
    path = explicit if explicit else target / ".aibom.json"
    if not path.exists():
        return {"excludes": [], "overrides": {}, "custom_components": []}
    try:
        cfg = json.loads(path.read_text())
    except json.JSONDecodeError as e:
        sys.exit(f"cpp-aibom: failed to parse {path}: {e}")
    cfg.setdefault("excludes", [])
    cfg.setdefault("overrides", {})
    cfg.setdefault("custom_components", [])
    return cfg


# ── Walker ─────────────────────────────────────────────────────────────────────
def walk_codebase(target: Path) -> tuple[list[Path], list[Path]]:
    """Return (source_files, cmake_files), pre-filtered against IGNORE_DIRS."""
    sources: list[Path] = []
    cmakes: list[Path] = []
    for root, dirs, files in os.walk(target):
        dirs[:] = [d for d in dirs if d not in IGNORE_DIRS and not d.startswith(".")]
        for f in files:
            p = Path(root) / f
            ext = p.suffix.lower()
            if ext in SOURCE_EXTS:
                sources.append(p)
            elif f in CMAKE_BASENAMES or ext in CMAKE_EXTS:
                cmakes.append(p)
    return sources, cmakes


# ── Signal extraction ──────────────────────────────────────────────────────────
class Signals:
    """Collected signals from a codebase scan, indexed for fast component matching."""

    def __init__(self) -> None:
        # include_path -> first file that contained it
        self.includes: dict[str, Path] = {}
        # cmake_name (lowercased) -> (file, line_excerpt)
        self.cmake: dict[str, tuple[Path, str]] = {}

    def add_include(self, path_str: str, source: Path) -> None:
        self.includes.setdefault(path_str, source)

    def add_cmake(self, name: str, source: Path, excerpt: str) -> None:
        self.cmake.setdefault(name.lower(), (source, excerpt[:200]))


def extract_signals(target: Path, sources: list[Path], cmakes: list[Path]) -> Signals:
    sig = Signals()
    for sf in sources:
        try:
            text = sf.read_text(errors="replace")
        except OSError:
            continue
        for m in _RE_INCLUDE.finditer(text):
            sig.add_include(m.group(1), sf)

    for cf in cmakes:
        try:
            text = cf.read_text(errors="replace")
        except OSError:
            continue
        for m in _RE_FIND_PACKAGE.finditer(text):
            name = m.group(1)
            line = _line_for(text, m.start())
            sig.add_cmake(name, cf, line)
        for m in _RE_PKG_CHECK.finditer(text):
            name = m.group(1)
            line = _line_for(text, m.start())
            sig.add_cmake(name, cf, line)
        for m in _RE_INCLUDE_CALL.finditer(text):
            name = m.group(1)
            # filter generic cmake stdlib (CMakePushCheckState, etc.)
            if name not in {"CMakePackageConfigHelpers", "GNUInstallDirs", "CMakeFindDependencyMacro",
                            "CheckCXXSourceCompiles", "CheckSymbolExists", "FetchContent",
                            "ExternalProject", "FindPkgConfig"}:
                line = _line_for(text, m.start())
                sig.add_cmake(name, cf, line)
        for m in _RE_TLL.finditer(text):
            body = m.group(1)
            line = _line_for(text, m.start())
            for tok in re.findall(r'[A-Za-z0-9_+.:-]+', body):
                # skip common keywords/scopes in TLL
                if tok.upper() in {"PUBLIC", "PRIVATE", "INTERFACE"}:
                    continue
                if tok.startswith("$"):
                    continue
                sig.add_cmake(tok, cf, line)
    return sig


def _line_for(text: str, pos: int) -> str:
    start = text.rfind("\n", 0, pos) + 1
    end = text.find("\n", pos)
    if end == -1:
        end = len(text)
    return text[start:end].strip()


# ── Matching ───────────────────────────────────────────────────────────────────
def match_component(comp: dict[str, Any], sig: Signals) -> dict[str, Any] | None:
    """Return a detection record for `comp` if any signal matches; else None."""
    include_hits: list[tuple[str, Path]] = []
    cmake_hits: list[tuple[str, Path, str]] = []

    for patt in comp["detect"]["include"]:
        if not patt:
            continue
        patt_l = patt.lower()
        for inc_path, src in sig.includes.items():
            if patt_l in inc_path.lower():
                include_hits.append((inc_path, src))
                break
    for patt in comp["detect"]["cmake"]:
        if not patt:
            continue
        key = patt.lower()
        if key in sig.cmake:
            src, excerpt = sig.cmake[key]
            cmake_hits.append((patt, src, excerpt))

    if not include_hits and not cmake_hits:
        return None

    if include_hits and cmake_hits:
        confidence = "high"
    else:
        confidence = "medium"

    # Choose "primary" detection line for the human-readable fields.
    if cmake_hits:
        name_matched, src, excerpt = cmake_hits[0]
        detection_str = f"cmake — CMake reference: {name_matched}"
        location = str(src)
        evidence = excerpt
    else:
        inc, src = include_hits[0]
        detection_str = f"include — #include matching: {inc.split('/')[0] or inc}"
        location = str(src)
        evidence = f"#include <{inc}>"

    return {
        "name": comp["name"],
        "category": comp.get("category", "other"),
        "description": comp.get("description", ""),
        "license": comp.get("license", ""),
        "purl": comp.get("purl", ""),
        "ai_ml": bool(comp.get("ai_ml", False)),
        "detection": detection_str,
        "location": location,
        "evidence": evidence,
        "confidence": confidence,
        "include_hits": [str(s) for _, s in include_hits],
        "cmake_hits": [{"name": n, "file": str(s), "line": e} for n, s, e in cmake_hits],
        "vulnerabilities": [],
    }


def apply_overrides(detected: list[dict[str, Any]], cfg: dict[str, Any]) -> list[dict[str, Any]]:
    excludes = set(cfg.get("excludes", []))
    overrides = cfg.get("overrides", {})
    out = []
    for d in detected:
        if d["name"] in excludes:
            continue
        if d["name"] in overrides:
            for k, v in overrides[d["name"]].items():
                d[k] = v
        out.append(d)
    # custom components: add as-is with confidence='manual'
    for c in cfg.get("custom_components", []):
        cc = {
            "name": c["name"],
            "category": c.get("category", "other"),
            "description": c.get("description", ""),
            "license": c.get("license", ""),
            "purl": c.get("purl", ""),
            "ai_ml": bool(c.get("ai_ml", False)),
            "detection": "manual — declared in .aibom.json",
            "location": c.get("location", ".aibom.json"),
            "evidence": "custom_components entry",
            "confidence": c.get("confidence", "high"),
            "include_hits": [],
            "cmake_hits": [],
            "vulnerabilities": [],
        }
        out.append(cc)
    return out


# ── Declared inventory: THIRD_PARTY_LICENSES, third_party/, FetchContent ───────
# The KB only finds libraries it already knows. The project's own license
# manifest and its vendored tree name every component it ships, usually with
# a version or pinned commit, so they are read as well and merged with the KB
# detections (one record per component).
_TPL_SECTION_RE = re.compile(r'^(\d+)\.[ \t]+(.+?)[ \t]*\n-{3,}[ \t]*$', re.MULTILINE)
_URL_RE = re.compile(r'https?://[^\s)>,`]+')
_SHA1_RE = re.compile(r'\b[0-9a-f]{40}\b')
_VER_RE = re.compile(r'(?<![\w.-])(?:v|version\s+|tag\s+v?|release\s+v?|\()(\d+\.\d+(?:\.\d+)*)\b',
                     re.IGNORECASE)
_TP_PATH_RE = re.compile(r'third_party/([\w.+-]+(?:/[\w.+-]+)*)')
_GO_ROW_RE = re.compile(r'^[ \t]+([a-z0-9][\w.-]*\.[a-z]{2,}(?:/[\w.~-]+)*)[ \t]+(v\d\S*)[ \t]+(\S+)[ \t]*$',
                        re.MULTILINE)
_BUNDLED_INSIDE_RE = re.compile(r'^[ \t]+-[ \t]+(\S+)[ \t]+(\S+)[ \t]+(https?://\S+)[ \t]*$', re.MULTILINE)
_FETCHCONTENT_RE = re.compile(
    r'FetchContent_Declare\s*\(\s*([\w.+-]+)\s+GIT_REPOSITORY\s+(\S+?)(?:\.git)?\s+GIT_TAG\s+([\w.+-]+)',
    re.IGNORECASE)
_HEADER_VER_RE = re.compile(r'#\s*define\s+\w*VERSION\w*\s+"v?(\d+\.\d+(?:\.\d+)*)"')
_HEADER_MAJOR_RE = re.compile(r'#\s*define\s+([A-Z][A-Z0-9]*?)_(?:VERSION_)?MAJOR\s+(\d+)\b')
# Purl types OSV.dev resolves by package version. C/C++ libraries are looked
# up by repository and tag or commit instead (OSV's GIT ecosystem).
_OSV_PURL_TYPES = {"golang", "pypi", "npm", "cargo", "maven", "nuget", "gem", "composer", "hex", "pub"}


def _norm(name: str) -> str:
    return re.sub(r'[^a-z0-9]', '', name.lower())


def _first_url(text: str) -> str:
    m = _URL_RE.search(text)
    return m.group(0).rstrip('.') if m else ""


def _field(body: str, *labels: str) -> str:
    """First value of an indented `Label: value` line in a manifest section."""
    for label in labels:
        m = re.search(r'^[ \t]*%s:[ \t]+(.+)$' % label, body, re.MULTILINE)
        if m:
            return m.group(1).strip()
    return ""


_LICENSE_NAMES = {
    "zlib license": "Zlib",
    "apache license 2.0": "Apache-2.0",
    "apache license, version 2.0": "Apache-2.0",
    "sil open font license, version 1.1": "OFL-1.1",
    "artistic license 2.0": "Artistic-2.0",
}


def _clean_license(text: str) -> str:
    text = re.sub(r'\s*\(.*', '', text).strip().rstrip('.;')
    m = re.match(r'([A-Za-z0-9.+-]+(?: (?:OR|AND|WITH) [A-Za-z0-9.+-]+)*),\s', text)
    if m and re.search(r'\d', m.group(1)):
        text = m.group(1)  # "GPL-3.0-or-later, following the release's LICENSE"
    low = text.lower()
    for name, spdx in _LICENSE_NAMES.items():
        if low == name or low.startswith(name + " ") or low.startswith(name + ","):
            return spdx if low == name else text
    return text


def _license_field(body: str) -> str:
    for m in re.finditer(r'^[ \t]*Licen[cs]es?(?: understanding)?:[ \t]+(.+)$', body, re.MULTILINE):
        value = m.group(1).strip()
        if not value.lower().startswith(("http://", "https://")):
            return _clean_license(value)
    return ""


def classify_license_file(text: str) -> str:
    """Best-effort SPDX id for a license file's text."""
    t = " ".join(text.split()).lower()
    # A GNU license text names the others in its preamble; its own title
    # comes first, so the earliest GNU title decides.
    head = t[:400]
    gnu = sorted((head.find(k), kind) for k, kind in (
        ("gnu lesser general public license", "LGPL"), ("gnu library general public license", "LGPL"),
        ("gnu affero general public license", "AGPL"), ("gnu general public license", "GPL"))
        if head.find(k) >= 0)
    if gnu:
        kind = gnu[0][1]
        v3 = "version 3" in head[gnu[0][0]: gnu[0][0] + 120]
        if kind == "LGPL":
            return "LGPL-3.0-or-later" if v3 else "LGPL-2.1-or-later"
        if kind == "AGPL":
            return "AGPL-3.0-or-later"
        return "GPL-3.0-or-later" if v3 else "GPL-2.0-or-later"
    if "apache license" in t and "version 2.0" in t:
        return "Apache-2.0"
    if "gnu lesser general public license" in t or "gnu library general public license" in t:
        return "LGPL-3.0-or-later" if "version 3" in t else "LGPL-2.1-or-later"
    if "gnu affero general public license" in t:
        return "AGPL-3.0-or-later"
    if "gnu general public license" in t:
        return "GPL-3.0-or-later" if "version 3" in t else "GPL-2.0-or-later"
    if "mozilla public license" in t:
        return "MPL-2.0"
    if "sil open font license" in t:
        return "OFL-1.1"
    if "permission is hereby granted, free of charge" in t:
        return "MIT"
    if "redistribution and use in source and binary forms" in t:
        return "BSD-3-Clause" if ("neither the name" in t or "the names of" in t) else "BSD-2-Clause"
    if "this software is provided 'as-is'" in t:
        return "Zlib"
    if "creative commons" in t and "cc0" in t:
        return "CC0-1.0"
    if "public domain" in t:
        return "LicenseRef-public-domain"
    return ""


def _purl_for(repo_url: str, version: str, commit: str, fallback: str = "") -> str:
    m = re.match(r'https?://github\.com/([\w.-]+)/([\w.-]+?)(?:\.git)?(?:/|$)', repo_url or "")
    base = f"pkg:github/{m.group(1)}/{m.group(2)}" if m else (fallback.split('@')[0] if fallback else "")
    ref = version or commit
    return f"{base}@{ref}" if base and ref else base


def _record(name: str, **kw: Any) -> dict[str, Any]:
    rec: dict[str, Any] = {
        "name": name, "category": "dependency", "description": "", "license": "", "purl": "",
        "ai_ml": False, "detection": "", "location": "", "evidence": "", "confidence": "high",
        "include_hits": [], "cmake_hits": [], "vulnerabilities": [],
        "version": "", "commit": "", "repo_url": "", "scope": "required", "delivery": "",
        "third_party": "", "type": "library",
    }
    rec.update({k: v for k, v in kw.items() if v is not None})
    return rec


def _section_delivery(title: str, body: str) -> tuple[str, str, str] | None:
    """(delivery, scope, cyclonedx type) for a manifest section, or None for
    sections that record a reference consulted, not software shipped."""
    t, b = title.lower(), " ".join(body.split()).lower()
    if "no code was copied" in b or "no code is incorporated" in b:
        return None
    if "documentation build only" in t or "documentation build only" in b:
        return ("documentation", "excluded", "file")
    if "model weights only" in b or ("model" in t and "download-on-demand" in t):
        return ("download", "optional", "machine-learning-model")
    if "download-on-demand" in t or "not bundled" in b:
        return ("download", "optional", "library")
    if "community dx database" in t or "bundled at resources/" in b:
        return ("bundled", "required", "data")
    if "(optional)" in t or "absent unless the setup script" in b:
        return ("prebuilt", "optional", "library")
    if "statically linked" in b:
        return ("linked", "required", "library")
    return ("bundled", "required", "library")


def parse_third_party_licenses(target: Path) -> list[dict[str, Any]]:
    path = target / "THIRD_PARTY_LICENSES"
    if not path.exists():
        return []
    text = path.read_text(errors="replace")
    heads = list(_TPL_SECTION_RE.finditer(text))
    out: list[dict[str, Any]] = []
    for i, h in enumerate(heads):
        title = h.group(2)
        body = text[h.end(): heads[i + 1].start() if i + 1 < len(heads) else len(text)]
        kind = _section_delivery(title, body)
        if kind is None:
            continue
        delivery, scope, ctype = kind
        name_part = re.split(r'\s+[—–-]\s+', title, maxsplit=1)
        name = re.sub(r'\s*\([^)]*\)', '', name_part[0]).strip()
        desc = name_part[1].strip() if len(name_part) > 1 else ""
        version = ""
        m = re.match(r'^(.*?)\s+v?(\d+\.\d+(?:\.\d+)*)$', name)
        if m:
            name, version = m.group(1), m.group(2)
        prose = "\n".join(l for l in _GO_ROW_RE.sub("", body).splitlines()
                          if not re.search(r'licen[cs]e|copyright|https?://', l, re.IGNORECASE))
        if not version:
            vm = _VER_RE.search(prose)
            version = vm.group(1) if vm else ""
        commit = ""
        for line in body.splitlines():
            if re.search(r'commit|import:', line, re.IGNORECASE):
                cm = _SHA1_RE.search(line)
                if cm:
                    commit = cm.group(0)
                    break
        tp = ""
        tm = re.search(r'(?:bundled|vendored|staged|built from source|binaries)\s+(?:at|under|as[^\n]*?at)\s+'
                       r'third_party/([\w.+-]+(?:/[\w.+-]+)*)', body, re.IGNORECASE)
        if tm:
            tp = tm.group(1).strip('/')
        if not commit and tp and (target / "third_party" / tp / "COMMIT").is_file():
            cm = _SHA1_RE.search((target / "third_party" / tp / "COMMIT").read_text(errors="replace"))
            commit = cm.group(0) if cm else ""
        repo = _first_url(_field(body, "Source", "Release", "Spec"))
        lic = _license_field(body)
        if _GO_ROW_RE.search(body) and "never linked into aethersdr" in " ".join(body.split()).lower():
            ctype = "application"  # a separate program in the tree; its modules follow
        rec = _record(
            name, description=desc, license=lic, version=version, commit=commit, repo_url=repo,
            scope=scope, delivery=delivery, third_party=tp, type=ctype,
            ai_ml=ctype == "machine-learning-model",
            detection=f"declared — THIRD_PARTY_LICENSES section {h.group(1)}",
            location=str(path), evidence=title, purl=_purl_for(repo, version, commit))
        out.append(rec)

        # Go modules listed as a table (vendored for a helper program).
        excluded_from = body.lower().find("vendored but not linked")
        for gm in _GO_ROW_RE.finditer(body):
            mod, ver, glic = gm.groups()
            out.append(_record(
                mod, category="dependency", license=glic, version=ver,
                purl=f"pkg:golang/{mod}@{ver}", delivery="vendored",
                scope="excluded" if 0 <= excluded_from < gm.start() else "required",
                detection=f"declared — THIRD_PARTY_LICENSES section {h.group(1)} (Go module of {name})",
                location=str(path), evidence=gm.group(0).strip(), confidence="high"))
        # Libraries bundled inside a prebuilt binary ("- name  License  URL").
        for bm in _BUNDLED_INSIDE_RE.finditer(body):
            sub, slic, surl = bm.groups()
            if _norm(sub) == _norm(name):
                continue
            out.append(_record(
                sub, license=slic, repo_url=surl, purl=_purl_for(surl, "", ""), scope=scope,
                delivery=f"inside {name}",
                detection=f"declared — THIRD_PARTY_LICENSES section {h.group(1)} (bundled in {name})",
                location=str(path), evidence=bm.group(0).strip()))
    return out


def _license_of_dir(d: Path) -> str:
    """SPDX ids of the directory's license files; several distinct ones
    (zstd ships LICENSE and COPYING) mean the code is offered under either."""
    found: list[str] = []
    for f in sorted(d.iterdir()):
        if f.is_file() and re.match(r'(licen[cs]e|copying)', f.name, re.IGNORECASE):
            spdx = classify_license_file(f.read_text(errors="replace")[:20000])
            if spdx and spdx not in found:
                found.append(spdx)
    return " OR ".join(found)


def _version_of_dir(d: Path) -> tuple[str, str, str]:
    """(version, commit, upstream url) recorded inside a vendored directory."""
    version = commit = upstream = ""
    vt = d / "VERSION.txt"
    if vt.is_file():
        txt = vt.read_text(errors="replace")
        m = re.search(r'\bv?(\d+\.\d+(?:\.\d+)*)\b', txt)
        version = m.group(1) if m else ""
        upstream = _first_url(txt)
    if (d / "COMMIT").is_file():
        m = _SHA1_RE.search((d / "COMMIT").read_text(errors="replace"))
        commit = m.group(0) if m else ""
    ra = d / "README.aethersdr.md"
    if ra.is_file():
        txt = ra.read_text(errors="replace")
        for line in txt.splitlines():
            if not commit and re.search(r'commit', line, re.IGNORECASE) and _SHA1_RE.search(line):
                commit = _SHA1_RE.search(line).group(0)
            if not upstream and re.search(r'upstream', line, re.IGNORECASE) and _URL_RE.search(line):
                upstream = _first_url(line)
    if not version:
        headers = sorted(d.rglob("*.h"), key=lambda p: (_norm(d.name) not in _norm(p.stem), len(p.parts)))
        for hf in headers[:200]:
            text = hf.read_text(errors="replace")[:100000]
            m = _HEADER_VER_RE.search(text)
            if m:
                version = m.group(1)
                break
            m = _HEADER_MAJOR_RE.search(text)
            if m:
                pre = re.escape(m.group(1))
                parts = [m.group(2)]
                for part in ("MINOR", "(?:PATCH|REVISION|MICRO|RELEASE)"):
                    pm = re.search(r'#\s*define\s+%s_(?:VERSION_)?%s\s+(\d+)\b' % (pre, part), text)
                    if not pm:
                        break
                    parts.append(pm.group(1))
                if len(parts) >= 2:
                    version = ".".join(parts)
                    break
    return version, commit, upstream


def scan_vendored(target: Path) -> dict[str, dict[str, Any]]:
    root = target / "third_party"
    out: dict[str, dict[str, Any]] = {}
    if not root.is_dir():
        return out
    for d in sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith('.')):
        version, commit, upstream = _version_of_dir(d)
        out[d.name] = _record(
            d.name, license=_license_of_dir(d), version=version, commit=commit, repo_url=upstream,
            delivery="bundled", third_party=d.name,
            detection="vendored — third_party/ directory", location=str(d),
            evidence=f"third_party/{d.name}/", purl=_purl_for(upstream, version, commit))
    return out


def scan_fetchcontent(cmakes: list[Path], target: Path) -> list[dict[str, Any]]:
    out = []
    for cf in cmakes:
        if "third_party" in cf.relative_to(target).parts:
            continue  # a vendored library's own optional fetches
        text = cf.read_text(errors="replace")
        for m in _FETCHCONTENT_RE.finditer(text):
            name, repo, tag = m.groups()
            version = tag.lstrip('v') if re.match(r'v?\d', tag) else tag
            commit = tag if _SHA1_RE.fullmatch(tag) else ""
            out.append(_record(
                name, version="" if commit else version, commit=commit, repo_url=repo,
                delivery="fetched at build time", detection="cmake — FetchContent_Declare",
                location=str(cf), evidence=_line_for(text, m.start()),
                purl=_purl_for(repo, "" if commit else version, commit)))
    return out


def _fill(dst: dict[str, Any], src: dict[str, Any], keys: tuple[str, ...]) -> None:
    for k in keys:
        if not dst.get(k) and src.get(k):
            dst[k] = src[k]


def merge_inventory(detected: list[dict[str, Any]], declared: list[dict[str, Any]],
                    vendored: dict[str, dict[str, Any]], fetched: list[dict[str, Any]],
                    kb: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """One record per component: manifest sections first, then vendored
    directories they don't cover, then fetched and KB-detected libraries."""
    out: list[dict[str, Any]] = []
    for rec in declared:
        v = vendored.pop(rec["third_party"], None) if rec["third_party"] else None
        if v:
            _fill(rec, v, ("version", "commit", "repo_url", "license"))
            rec["purl"] = _purl_for(rec["repo_url"], rec["version"], rec["commit"], rec["purl"])
        out.append(rec)
    out.extend(vendored.values())
    by_name = {_norm(r["name"]): r for r in out}
    for rec in fetched:
        if _norm(rec["name"]) in by_name:
            _fill(by_name[_norm(rec["name"])], rec, ("version", "commit", "repo_url"))
        else:
            out.append(rec)
            by_name[_norm(rec["name"])] = rec
    by_dir = {r["third_party"]: r for r in out if r["third_party"]}
    kb_by_name = {c["name"]: c for c in kb}
    for det in detected:
        meta = kb_by_name.get(det["name"], {})
        target_rec = by_dir.get(meta.get("third_party", "")) or by_name.get(_norm(det["name"]))
        if target_rec is None:
            det.update({"version": det.get("version", ""), "commit": "", "repo_url": meta.get("repo_url", ""),
                        "scope": meta.get("scope", det.get("scope", "required")), "delivery": det.get("delivery", "system / package manager"),
                        "third_party": meta.get("third_party", ""), "type": det.get("type", "library")})
            out.append(det)
            continue
        target_rec["category"] = det["category"]
        target_rec["ai_ml"] = target_rec["ai_ml"] or det["ai_ml"]
        target_rec["confidence"] = det["confidence"] if det["confidence"] == "high" else target_rec["confidence"]
        target_rec["include_hits"] = det["include_hits"]
        target_rec["cmake_hits"] = det["cmake_hits"]
        target_rec["detection"] = f'{target_rec["detection"]}; {det["detection"]}'
        _fill(target_rec, det, ("description", "license"))
        _fill(target_rec, meta, ("repo_url",))
        if not target_rec["purl"] or target_rec["purl"].startswith("pkg:generic"):
            target_rec["purl"] = _purl_for(target_rec["repo_url"], target_rec["version"],
                                           target_rec["commit"], det["purl"])
    return out


# ── OSV.dev client ─────────────────────────────────────────────────────────────
def osv_queries(rec: dict[str, Any]) -> list[dict[str, Any]]:
    """OSV.dev query bodies for a component. Versioned purls of ecosystems
    OSV indexes go by purl; C/C++ sources by repository plus commit or tag."""
    purl, version, commit, repo = rec.get("purl", ""), rec.get("version", ""), rec.get("commit", ""), rec.get("repo_url", "")
    ptype = purl[4:].split('/', 1)[0] if purl.startswith("pkg:") else ""
    if ptype in _OSV_PURL_TYPES and "@" in purl:
        return [{"package": {"purl": purl}}]
    m = re.match(r'(https?://(?:github\.com|gitlab\.[\w.]+)/[\w.-]+/[\w.-]+?)(?:\.git)?(?:/|$)', repo or "")
    if m:
        if commit:
            return [{"commit": commit}]
        if version:
            tags = [version] if version.startswith('v') else [version, f"v{version}"]
            return [{"version": t, "package": {"name": m.group(1), "ecosystem": "GIT"}} for t in tags]
        return []
    if purl and "@" not in purl and ptype not in ("github", "generic"):
        return [{"package": {"purl": purl}}]
    return []


def osv_lookup(rec: dict[str, Any]) -> list[dict[str, Any]]:
    seen: dict[str, dict[str, Any]] = {}
    for q in osv_queries(rec):
        for v in osv_query(q):
            seen.setdefault(v["id"], v)
    return list(seen.values())


def osv_query(query: dict[str, Any] | str) -> list[dict[str, Any]]:
    """Query OSV.dev; return list of vulnerability dicts. Cached on disk.
    A bare string is taken as a purl (the original call form)."""
    if not query:
        return []
    if isinstance(query, str):
        query = {"package": {"purl": query}}
    purl = json.dumps(query, sort_keys=True)
    OSV_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache_file = OSV_CACHE_DIR / f"{_purl_hash(purl)}.json"
    if cache_file.exists() and (time.time() - cache_file.stat().st_mtime) < OSV_CACHE_TTL:
        try:
            cached = json.loads(cache_file.read_text())
            # Cached entries are already summarized (post-`_summarize_vulns`).
            return cached.get("summarized", [])
        except Exception:
            pass  # fall through to refetch

    body = json.dumps(query).encode()
    req = Request(OSV_API_URL, data=body, method="POST",
                  headers={"Content-Type": "application/json", "User-Agent": f"cpp-aibom/{VERSION}"})

    last_err = None
    for attempt in range(OSV_MAX_RETRIES + 1):
        try:
            with urlopen(req, timeout=OSV_TIMEOUT) as resp:
                payload = json.loads(resp.read().decode())
            raw_vulns = payload.get("vulns", [])
            summarized = _summarize_vulns(raw_vulns)
            cache_file.write_text(json.dumps({
                "purl": purl,
                "queried_at": _iso_now(),
                "summarized": summarized,
            }))
            return summarized
        except HTTPError as e:
            if e.code == 404:
                # No vulns for this purl — cache empty.
                cache_file.write_text(json.dumps({
                    "purl": purl, "queried_at": _iso_now(), "summarized": [],
                }))
                return []
            last_err = f"HTTP {e.code}"
        except URLError as e:
            last_err = f"network: {e.reason}"
        except Exception as e:
            last_err = f"{type(e).__name__}: {e}"
        time.sleep(1)
    sys.stderr.write(f"cpp-aibom: OSV.dev query failed for {purl}: {last_err}\n")
    return []


def _summarize_vulns(raw_vulns: list[dict[str, Any]]) -> list[dict[str, Any]]:
    out = []
    for v in raw_vulns:
        sev_label = "UNKNOWN"
        max_score = -1.0
        # 1. CVSS vectors (highest signal — the standard CVE path).
        for rating in v.get("severity", []) or []:
            score_str = rating.get("score", "")
            num = _cvss_base_score(score_str)
            if num is not None and num > max_score:
                max_score = num
        if max_score >= 9.0:
            sev_label = "CRITICAL"
        elif max_score >= 7.0:
            sev_label = "HIGH"
        elif max_score >= 4.0:
            sev_label = "MEDIUM"
        elif max_score >= 0:
            sev_label = "LOW"
        # 2. database_specific.severity (some sources put a plain string here).
        if sev_label == "UNKNOWN":
            ds = v.get("database_specific") or {}
            if isinstance(ds, dict):
                ds_sev = ds.get("severity")
                if isinstance(ds_sev, str) and ds_sev.upper() in {"CRITICAL", "HIGH", "MEDIUM", "LOW"}:
                    sev_label = ds_sev.upper()
        # 3. Heuristic for OSS-Fuzz entries (OSV-YYYY-N) which carry no rating:
        #    crash-class keywords in summary imply HIGH severity (memory-safety bugs
        #    in C/C++ are usually exploitable). Bias up rather than down — false
        #    HIGH is recoverable, missed CRITICAL is not.
        if sev_label == "UNKNOWN":
            text = ((v.get("summary") or "") + " " + (v.get("details") or "")).lower()
            if any(k in text for k in (
                "heap-buffer-overflow", "stack-buffer-overflow", "use-after-free",
                "out-of-bounds", "integer-overflow", "null-deref", "double-free",
                "uninitialized", "global-buffer-overflow", "memory leak",
            )):
                sev_label = "HIGH"
        out.append({
            "id": v.get("id", ""),
            "aliases": v.get("aliases", []),
            "summary": (v.get("summary") or v.get("details", "")).strip()[:240],
            "severity": sev_label,
            "score": max_score if max_score >= 0 else None,
            "references": [r.get("url", "") for r in (v.get("references") or [])[:3]],
        })
    return out


_CVSS_BASE_RE = re.compile(r'CVSS:[\d.]+/[^/]*?\bAV:', re.IGNORECASE)


def _cvss_base_score(vector: str) -> float | None:
    # OSV returns full CVSS vectors as strings. We parse out the metrics naively
    # and use a lookup — sufficient for severity-band classification.
    if not vector or "CVSS" not in vector:
        return None
    # OSV sometimes includes a /baseScore=X.Y suffix; prefer that when present.
    m = re.search(r'baseScore=(\d+(?:\.\d+)?)', vector)
    if m:
        try:
            return float(m.group(1))
        except ValueError:
            pass
    # Approximate from AV/AC/PR/UI/S/C/I/A — full CVSS calc is overkill.
    # Use AV (Attack Vector) as primary band: N=high, A=med, L/P=low.
    av = re.search(r'AV:([NALP])', vector)
    s = re.search(r'/S:([UC])', vector)
    if not av:
        return None
    base = {"N": 8.0, "A": 6.5, "L": 5.0, "P": 4.0}.get(av.group(1), 5.0)
    if s and s.group(1) == "C":  # scope changed = bump
        base = min(base + 1.0, 10.0)
    return base


def enrich_with_osv(detected: list[dict[str, Any]]) -> None:
    for d in detected:
        d["vulnerabilities"] = osv_lookup(d)


# ── Output: aibom-json (dashboard-compatible) ──────────────────────────────────
def emit_aibom_json(target: Path, components: list[dict[str, Any]]) -> dict[str, Any]:
    total_vulns = sum(len(c["vulnerabilities"]) for c in components)
    by_conf: dict[str, int] = {}
    for c in components:
        by_conf[c["confidence"]] = by_conf.get(c["confidence"], 0) + 1
    return {
        "scanner": "cpp-aibom",
        "version": VERSION,
        "scan_time": _iso_now(),
        "target": str(target),
        "aibom_analysis": {
            "summary": {
                "total_components": len(components),
                "total_model_files": sum(1 for c in components if c["ai_ml"]),
                "has_neural_components": any(c["ai_ml"] for c in components),
                "vulnerabilities_found": total_vulns,
                "high_confidence": by_conf.get("high", 0),
                "medium_confidence": by_conf.get("medium", 0),
                "low_confidence": by_conf.get("low", 0),
            },
            "components": components,
        },
    }


# ── Output: CycloneDX 1.6 ML-BOM ──────────────────────────────────────────────
def emit_cyclonedx(target: Path, components: list[dict[str, Any]]) -> dict[str, Any]:
    serial = f"urn:uuid:{uuid.uuid4()}"
    target_ref = "urn:component:root"
    cdx_components = []
    cdx_vulns = []
    used_refs: set[str] = set()
    for c in components:
        ref = f"urn:component:{_slug(c['name'])}"
        n = 2
        while ref in used_refs:
            ref = f"urn:component:{_slug(c['name'])}-{n}"
            n += 1
        used_refs.add(ref)
        # ML-BOM: ai_ml components get type=machine-learning-model
        ctype = c.get("type") or "library"
        if c["ai_ml"] and ctype == "library":
            ctype = "machine-learning-model"
        comp: dict[str, Any] = {
            "bom-ref": ref,
            "type": ctype,
            "name": c["name"],
        }
        if c.get("version") or c.get("commit"):
            comp["version"] = c.get("version") or c["commit"]
        comp["description"] = c["description"]
        comp["scope"] = c.get("scope") or "required"
        props = [
            {"name": "aibom:category", "value": c["category"]},
            {"name": "aibom:confidence", "value": c["confidence"]},
            {"name": "aibom:detection", "value": c["detection"]},
            {"name": "aibom:location", "value": c["location"]},
        ]
        for key in ("delivery", "commit", "third_party"):
            if c.get(key):
                props.append({"name": f"aibom:{key}", "value": c[key]})
        comp["properties"] = props
        if c["purl"]:
            comp["purl"] = c["purl"]
        if c["license"]:
            comp["licenses"] = [_license_choice(c["license"])]
        if c.get("repo_url"):
            kind = "vcs" if re.match(r'https?://(github\.com|gitlab\.)', c["repo_url"]) else "website"
            comp["externalReferences"] = [{"type": kind, "url": c["repo_url"]}]
        cdx_components.append(comp)
        for v in c["vulnerabilities"]:
            cdx_vulns.append({
                "bom-ref": f"urn:vuln:{_slug(v['id'])}",
                "id": v["id"],
                "ratings": [{"severity": v["severity"].lower()}] if v["severity"] != "UNKNOWN" else [],
                "description": v["summary"],
                "advisories": [{"url": url} for url in v["references"] if url],
                "affects": [{"ref": ref}],
            })

    return {
        "$schema": "http://cyclonedx.org/schema/bom-1.6.schema.json",
        "bomFormat": "CycloneDX",
        "specVersion": "1.6",
        "serialNumber": serial,
        "version": 1,
        "metadata": {
            "timestamp": _iso_now(),
            "tools": {
                "components": [{
                    "type": "application",
                    "name": "cpp-aibom",
                    "version": VERSION,
                }],
            },
            "component": _root_component(target, target_ref),
        },
        "components": cdx_components,
        "vulnerabilities": cdx_vulns,
    }


def _root_component(target: Path, ref: str) -> dict[str, Any]:
    root: dict[str, Any] = {"bom-ref": ref, "type": "application", "name": target.name or "target"}
    try:
        import subprocess
        head = subprocess.run(["git", "-C", str(target), "rev-parse", "HEAD"],
                              capture_output=True, text=True, timeout=10).stdout.strip()
        if _SHA1_RE.fullmatch(head):
            root["version"] = head
    except (OSError, ValueError):
        pass
    return root


def _license_choice(text: str) -> dict[str, Any]:
    """A CycloneDX license choice: an SPDX expression for "A OR B" forms,
    otherwise a single license by id or name."""
    if re.fullmatch(r'[A-Za-z0-9.+-]+(?: (?:OR|AND|WITH) [A-Za-z0-9.+-]+)+', text):
        return {"expression": text}
    return {"license": _license_entry(text)}


def _license_entry(spdx: str) -> dict[str, str]:
    # SPDX IDs use specific syntax; treat anything unrecognized as `name`.
    if re.match(r'^[A-Za-z0-9.+-]+$', spdx) and ("-" in spdx or spdx in {"MIT", "ISC", "Zlib", "blessing", "Unlicense", "curl", "libpng"}):
        return {"id": spdx}
    return {"name": spdx}


def _slug(s: str) -> str:
    return re.sub(r'[^a-z0-9-]+', '-', s.lower()).strip('-') or "x"


# ── Output: SARIF 2.1.0 (CVE findings) ─────────────────────────────────────────
def emit_sarif(target: Path, components: list[dict[str, Any]]) -> dict[str, Any]:
    results = []
    rules: dict[str, dict[str, Any]] = {}
    sev_to_level = {"CRITICAL": "error", "HIGH": "error", "MEDIUM": "warning", "LOW": "note", "UNKNOWN": "note"}

    for c in components:
        for v in c["vulnerabilities"]:
            rule_id = f"cpp-aibom-{v['severity'].lower()}"
            rules.setdefault(rule_id, {
                "id": rule_id,
                "name": f"Vulnerability-{v['severity']}",
                "shortDescription": {"text": f"{v['severity']} severity vulnerability in a detected component"},
                "fullDescription": {"text": "cpp-aibom queries OSV.dev for known vulnerabilities in detected C++ dependencies."},
                "defaultConfiguration": {"level": sev_to_level.get(v["severity"], "note")},
            })
            try:
                rel_loc = str(Path(c["location"]).relative_to(target))
            except ValueError:
                rel_loc = c["location"]
            results.append({
                "ruleId": rule_id,
                "level": sev_to_level.get(v["severity"], "note"),
                "message": {"text": f"{c['name']} — {v['id']}: {v['summary']}"},
                "locations": [{
                    "physicalLocation": {
                        "artifactLocation": {"uri": rel_loc},
                        "region": {"startLine": 1},
                    },
                }],
                "properties": {
                    "component": c["name"],
                    "purl": c["purl"],
                    "severity": v["severity"],
                    "score": v["score"],
                    "advisory_id": v["id"],
                    "references": v["references"],
                },
            })

    return {
        "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
        "version": "2.1.0",
        "runs": [{
            "tool": {
                "driver": {
                    "name": "cpp-aibom",
                    "version": VERSION,
                    "informationUri": "https://github.com/ten9876/aetherclaude",
                    "rules": list(rules.values()),
                },
            },
            "results": results,
        }],
    }


# ── Diff command ───────────────────────────────────────────────────────────────
def cmd_diff(args: argparse.Namespace) -> int:
    baseline = json.loads(Path(args.baseline).read_text())
    current = json.loads(Path(args.current).read_text())
    b_comps = {c["name"]: c for c in baseline.get("aibom_analysis", {}).get("components", [])}
    c_comps = {c["name"]: c for c in current.get("aibom_analysis", {}).get("components", [])}

    added = sorted(set(c_comps) - set(b_comps))
    removed = sorted(set(b_comps) - set(c_comps))
    changed = []
    new_vulns: list[tuple[str, dict[str, Any]]] = []

    for name in sorted(set(b_comps) & set(c_comps)):
        b, c = b_comps[name], c_comps[name]
        deltas: list[str] = []
        if b.get("confidence") != c.get("confidence"):
            deltas.append(f"confidence: {b.get('confidence')} → {c.get('confidence')}")
        b_vulns = {v["id"] for v in b.get("vulnerabilities", [])}
        c_vulns = {v["id"] for v in c.get("vulnerabilities", [])}
        added_vulns = c_vulns - b_vulns
        if added_vulns:
            deltas.append(f"new vulns: {sorted(added_vulns)}")
            for v in c["vulnerabilities"]:
                if v["id"] in added_vulns:
                    new_vulns.append((name, v))
        removed_vulns = b_vulns - c_vulns
        if removed_vulns:
            deltas.append(f"resolved vulns: {sorted(removed_vulns)}")
        if deltas:
            changed.append((name, deltas))

    print(f"cpp-aibom diff — {args.baseline} → {args.current}")
    print()
    if added:
        print(f"Added ({len(added)}):")
        for n in added:
            print(f"  + {n}  [{c_comps[n].get('category','')}]")
        print()
    if removed:
        print(f"Removed ({len(removed)}):")
        for n in removed:
            print(f"  - {n}  [{b_comps[n].get('category','')}]")
        print()
    if changed:
        print(f"Changed ({len(changed)}):")
        for n, deltas in changed:
            print(f"  ~ {n}: {'; '.join(deltas)}")
        print()
    if new_vulns:
        print(f"NEW VULNERABILITIES ({len(new_vulns)}):")
        for comp, v in new_vulns:
            print(f"  ! {comp} {v['severity']:8s} {v['id']:24s} {v['summary'][:80]}")
        print()
    if not (added or removed or changed):
        print("No changes.")
    # exit non-zero if new vulns appeared — useful for CI gates
    return 1 if new_vulns else 0


# ── Scan command ───────────────────────────────────────────────────────────────
def cmd_scan(args: argparse.Namespace) -> int:
    target = Path(args.path).resolve()
    if not target.exists():
        sys.exit(f"cpp-aibom: target not found: {target}")
    kb = load_kb(Path(args.kb) if args.kb else DEFAULT_KB)
    cfg = load_overrides(target, Path(args.config) if args.config else None)

    sources, cmakes = walk_codebase(target)
    if args.verbose:
        sys.stderr.write(f"cpp-aibom: scanning {len(sources)} source + {len(cmakes)} cmake files\n")
    sig = extract_signals(target, sources, cmakes)

    detected: list[dict[str, Any]] = []
    for comp in kb:
        rec = match_component(comp, sig)
        if rec:
            detected.append(rec)
    detected = merge_inventory(detected, parse_third_party_licenses(target), scan_vendored(target),
                               scan_fetchcontent(cmakes, target), kb)
    detected = apply_overrides(detected, cfg)
    detected.sort(key=lambda c: (c["category"], c["name"]))

    if not args.no_osv:
        if args.verbose:
            sys.stderr.write(f"cpp-aibom: querying OSV.dev for {len(detected)} components\n")
        enrich_with_osv(detected)

    fmt = args.format
    if fmt == "aibom-json":
        out = emit_aibom_json(target, detected)
    elif fmt == "cyclonedx":
        out = emit_cyclonedx(target, detected)
    elif fmt == "sarif":
        out = emit_sarif(target, detected)
    else:
        sys.exit(f"cpp-aibom: unknown --format {fmt}")

    rendered = json.dumps(out, indent=2)
    if args.output:
        _atomic_write(Path(args.output), rendered)
        if args.verbose:
            sys.stderr.write(f"cpp-aibom: wrote {args.output}\n")
    else:
        sys.stdout.write(rendered + "\n")

    # Optional side-output in CycloneDX format — saves a second full scan
    # when both formats are needed (e.g. dashboard-shape JSON for the modal
    # AND a CycloneDX file for /sbom.json download).
    if args.also_cyclonedx and fmt != "cyclonedx":
        cdx = emit_cyclonedx(target, detected)
        _atomic_write(Path(args.also_cyclonedx), json.dumps(cdx, indent=2))
        if args.verbose:
            sys.stderr.write(f"cpp-aibom: also wrote CycloneDX -> {args.also_cyclonedx}\n")

    # Exit code: non-zero if there are HIGH/CRITICAL vulns and --fail-on-vuln is set
    if args.fail_on_vuln:
        sev_set = {s.upper() for s in args.fail_on_vuln.split(",")}
        for c in detected:
            for v in c["vulnerabilities"]:
                if v["severity"] in sev_set:
                    sys.stderr.write(f"cpp-aibom: FAIL — {c['name']} has {v['severity']} CVE {v['id']}\n")
                    return 1
    return 0


# ── CLI ────────────────────────────────────────────────────────────────────────
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="cpp-aibom", description="C++ AI Bill of Materials scanner.")
    p.add_argument("--version", action="version", version=f"cpp-aibom {VERSION}")
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("scan", help="Scan a codebase (default subcommand).")
    sp.add_argument("path", help="Target directory (codebase root).")
    sp.add_argument("-f", "--format", default="aibom-json",
                    choices=["aibom-json", "cyclonedx", "sarif"],
                    help="Output format (default: aibom-json — the dashboard shape).")
    sp.add_argument("-o", "--output", help="Write to FILE instead of stdout.")
    sp.add_argument("--kb", help="Override KB path (default: data/cpp-aibom-components.json).")
    sp.add_argument("--config", help="Override .aibom.json path.")
    sp.add_argument("--no-osv", action="store_true", help="Skip OSV.dev CVE lookups (fast path).")
    sp.add_argument("--fail-on-vuln", help="Exit non-zero if any matching severity found (e.g. HIGH,CRITICAL).")
    sp.add_argument("--also-cyclonedx", metavar="PATH",
                    help="Additionally write a CycloneDX 1.6 ML-BOM side-output to PATH. "
                         "Useful for one-pass dual-format runs (e.g. dashboard JSON + downloadable SBOM).")
    sp.add_argument("-v", "--verbose", action="store_true")

    dp = sub.add_parser("diff", help="Compare two aibom-json snapshots.")
    dp.add_argument("baseline", help="Baseline JSON (older).")
    dp.add_argument("current", help="Current JSON (newer).")

    return p


def main() -> int:
    parser = build_parser()
    # Accept `cpp-aibom <path>` as shorthand for `cpp-aibom scan <path>`.
    argv = sys.argv[1:]
    if argv and argv[0] not in {"scan", "diff", "--help", "-h", "--version"} and not argv[0].startswith("-"):
        argv = ["scan"] + argv
    args = parser.parse_args(argv)

    if args.cmd == "scan":
        return cmd_scan(args)
    if args.cmd == "diff":
        return cmd_diff(args)
    parser.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
