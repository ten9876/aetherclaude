<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aetherclaude.dashboard</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Dedicated venv so the dashboard can import the Galileo SDK without
             writing into the shared Homebrew site-packages. Create it once with:
             python3 -m venv /Users/Shared/aetherclaude/.venv &&
             /Users/Shared/aetherclaude/.venv/bin/pip install galileo
             Falls back gracefully (galileo_forward fail-opens) if absent. -->
        <string>/Users/Shared/aetherclaude/.venv/bin/python3</string>
        <string>/Users/aetherclaude/bin/tetragon-dashboard.py</string>
        <string>--port</string>
        <string>8080</string>
        <string>--bind</string>
        <string>0.0.0.0</string>
    </array>
    <key>UserName</key>
    <string>aetherclaude</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- The dashboard runs sandboxed (uid 965) so its direct egress is
             pf-blocked. Route its Galileo + GitHub calls through tinyproxy,
             whose allowlist covers api.multitenant.galileocloud.io and github.
             tinyproxy (uid nobody) resolves the instance fresh each connection,
             so the ELB's rotating IPs need no /etc/hosts or pf IP pinning.
             Localhost stays direct (self, MCP/codegraph, Ollama). -->
        <key>HTTPS_PROXY</key>
        <string>http://127.0.0.1:8888</string>
        <key>HTTP_PROXY</key>
        <string>http://127.0.0.1:8888</string>
        <key>NO_PROXY</key>
        <string>127.0.0.1,localhost,::1</string>
    </dict>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aetherclaude/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aetherclaude/logs/dashboard-error.log</string>
</dict>
</plist>
