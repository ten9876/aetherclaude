<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aetherclaude.codegraph-refresh</string>

  <!--
    Nightly rebuild of the codegraph SQLite database read by the
    dashboard's /codegraph route. Steps 1-3 inside a Linux container
    (Colima or Docker Desktop on the Mac Mini); step 4 on the host:

      1. cmake configure        — produces compile_commands.json
                                  (~10 s — no actual build)
      2. codegraph-extract-clangd.py — libclang-driven AST extraction
                                  incl. the security-overlay call_tags
                                  (~20 min on 10 perf cores)
      3. codegraph-analyze.py   — Louvain community detection
                                  (~0.5 s)
      4. codegraph-cartographer.py — repo-context pack (repo-context.md
                                  /.json) from the fresh DB + aibom CVEs.
                                  Runs on the HOST (not the container):
                                  aibom-latest.json lives outside the
                                  container's mounts. Stdlib-only, <1 s.
                                  Degrades gracefully if the aibom file
                                  isn't jeremy-readable (CVE section
                                  omitted, pack still emitted).

    Why containerized: AetherSDR is Linux-native and its ccdb references
    Linux include paths (Qt6 from apt, PipeWire/ALSA dev headers). The
    aetherclaude-codegraph image is a thin layer over the AetherSDR CI
    image, adding clang + libclang + python3-clang. Build once with:
        docker build -t aetherclaude-codegraph:latest \
                     /Users/Shared/aetherclaude/docker/codegraph

    Total budget ~25 min — measured, not estimated: 1367 s on 2026-09-01
    over 2058 TUs. The older "~3 min" figure in this file was never right;
    the last 24.04-based run took 3046 s. Schedule at 03:00 local so it never overlaps
    an orchestrator run (those fire when webhooks arrive — bunched in
    business hours).

    Output: /Users/Shared/aetherclaude/data/codegraph.db (atomically
    replaced) — the path tetragon-dashboard.py reads as CODEGRAPH_DB. The
    stale file under /Users/aetherclaude/data is an orphan from the old
    location and is read by nothing.
    Dashboard reads it lazily on /api/codegraph/data requests, so no
    daemon restart is needed; the next page load picks up the new db.
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/opt/homebrew/bin/docker run --rm --name codegraph-refresh -v /Users/aetherclaude/workspace/AetherSDR:/src:ro -v /Users/Shared/aetherclaude/bin:/tools:ro -v /Users/Shared/aetherclaude/data:/out aetherclaude-codegraph:latest /codegraph-run.sh &amp;&amp; /usr/bin/python3 /Users/Shared/aetherclaude/bin/codegraph-cartographer.py</string>
  </array>

  <!--
    Runs as jeremy because:
      a) colima's docker socket lives in jeremy's home dir
         (~/.colima/default/docker.sock) — only jeremy can talk to it
      b) the output path /Users/Shared/aetherclaude/data is world-
         writable, so the resulting codegraph.db is reachable by the
         aetherclaude-owned dashboard process for reading.
    If we ever spin up a system-wide colima, this can revert to
    UserName=aetherclaude for tighter privilege separation.
  -->
  <key>UserName</key>
  <string>jeremy</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/jeremy</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!--
    Run once at load too, so a fresh deploy (no codegraph.db yet)
    produces a usable db within seconds rather than waiting until the
    next 03:00 window. Set false if you'd rather wait.
  -->
  <!--
    Deliberately no RunAtLoad. At boot this fires before local.colima has
    finished bringing its VM up, so `docker run` fails with "Cannot connect
    to the Docker daemon" and the job burns an exit 1 on every restart —
    63 of them in the current log. The 03:00 schedule is the only trigger
    that matters; by then colima has been warm for hours.
  -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Log path under /Users/Shared so the jeremy-owned launchd job can
       write it. /Users/aetherclaude/logs was aetherclaude-owned and
       not writable by jeremy. -->
  <key>StandardOutPath</key>
  <string>/Users/Shared/aetherclaude/logs/codegraph-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/aetherclaude/logs/codegraph-refresh.log</string>

  <!--
    Not KeepAlive — this is a periodic one-shot. We want launchd to
    invoke it at 03:00 and let it exit. If it crashes immediately on
    load, ThrottleInterval prevents tight restart loops.
  -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
</dict>
</plist>
