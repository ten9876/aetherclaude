# GitHub
^api\.github\.com$
^github\.com$
^.*\.githubusercontent\.com$
^uploads\.github\.com$
^objects\.githubusercontent\.com$
# GitHub Actions job logs: the logs API redirects to pre-signed URLs on these
# storage accounts. The dashboard reads build stats (compiler-cache hits) from them.
# tinyproxy filters use POSIX basic regex here: `+` is literal, so no `[0-9]+`.
^productionresultssa[0-9][0-9]*\.blob\.core\.windows\.net$

# pip endpoints — added 2026-05-07 to allow mcp-scanner / Cisco AI scanners upgrades
^pypi\.org$
^files\.pythonhosted\.org$

# Sigstore TUF trust root + Rekor log — added 2026-10-01 so the DefenseClaw
# upgrade resolver's cosign check of signed release checksums can run as the
# agent user
^tuf-repo-cdn\.sigstore\.dev$
^rekor\.sigstore\.dev$

# VirusTotal API — added 2026-05-07 for mcp-scanner virustotal subcommand
^www\.virustotal\.com$
^virustotal\.com$

# Galileo eval (new multitenant instance) — the trusted dashboard forwards
# agent-run traces here (it holds GALILEO_API_KEY); the eval job logs
# experiments. Routed through the proxy so the ELB's rotating IPs resolve fresh.
# The interactive `claude` child has no Galileo key, so reachability alone
# grants it nothing.
^api\.multitenant\.galileocloud\.io$
^console\.multitenant\.galileocloud\.io$
