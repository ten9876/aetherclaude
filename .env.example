# AetherClaude environment — copy to ~/.env and fill in
#
#   cp .env.example ~/.env
#   chmod 600 ~/.env
#
# ~/.env is sourced by run-agent.sh and loaded by the Python services
# (tetragon-dashboard.py, eslogger-bridge.py). DO NOT commit it.

# GitHub App numeric ID — get this from your App's settings page
GITHUB_APP_ID=

# HMAC secret used to verify GitHub webhooks to the dashboard
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# Galileo eval/observability (app.galileo.ai — free dev tier).
# The real GALILEO_API_KEY lives ONLY in the Mac Mini's /Users/aetherclaude/.env
# (chmod 600, gitignored). Never commit it. Only the dashboard process reads it;
# it is deliberately NOT passed to the sandboxed `claude` child (see run-agent.sh
# run_claude env allowlist) and Galileo is denied at the tinyproxy layer so the
# agent cannot reach it — only the trusted dashboard forwards traces.
GALILEO_API_KEY=
GALILEO_PROJECT=aetherclaude
GALILEO_LOG_STREAM=agent-runs
